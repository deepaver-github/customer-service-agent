.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
bash.exe.stackdump
frontend/bash.exe.stackdump

# Tests & docs not needed at runtime
tests/
docs/
*.md
!agent_config.yaml

# Tooling
docker-compose.yml
Dockerfile
.dockerignore
